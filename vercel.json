{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/question-paper",
      "destination": "/question-paper.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?_api_path=$1"
    }
  ]
}
